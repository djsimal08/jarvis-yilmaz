{
  "manifest_version": 3,
  "name": "JARVIS Yerel Chrome Kontrolü",
  "version": "0.1.0",
  "description": "Yalnızca bilgisayarınızdaki JARVIS ajanıyla eşleştirilmiş Chrome kontrol katmanı.",
  "permissions": ["tabs", "activeTab", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"],
  "background": {"service_worker": "service-worker.js"},
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content-script.js"],
    "run_at": "document_idle"
  }],
  "options_page": "options.html",
  "action": {"default_title": "JARVIS"}
}
